 `);
 function showItems() {
    if (!window.__items.length)
        return console.log("📭 No items saved.");

    console.log("📋 SAVED ITEMS LIST\n" + "=".repeat(60));

    window.__items.forEach((item, index) => {
        console.log(`
[${index}] 📌 ${item.name}
     📝 Description  : ${item.description || "—"}
     🔗 Navigates    : ${item.isNavigatingToOtherPage ? "✅ Yes (other page)" : "❌ No (same page)"}
     📍 Coords       : x=${Math.round(item.x)}, y=${Math.round(item.y)}
     💬 Text Preview : ${item.text || "—"}
        `);
    });

    console.log("=".repeat(60));
    console.log(`✅ Total: ${window.__items.length} item(s)`);
}